# Copy to .env and fill in before `docker compose up --build`.
# Never commit the real .env.

# REQUIRED: long random string. The API logs a warning and refuses to be
# secure if you leave the default.
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Optional: object storage for job-output delivery (needs --profile storage).
# STORAGE_BACKEND=s3
# S3_BUCKET=rexcrop-outputs
# S3_ENDPOINT_URL=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=rexcrop
# S3_SECRET_ACCESS_KEY=rexcrop-minio-secret
# PRESIGNED_URL_EXPIRES_IN=3600

# Optional: email alerts for finished jobs.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=RexCrop <noreply@example.com>

# Optional: AI services.
# OPENAI_API_KEY=

# Optional: processing knobs.
# WHISPER_MODEL=base
# MAX_UPLOAD_BYTES=2147483648
# USER_STORAGE_QUOTA_BYTES=10737418240
