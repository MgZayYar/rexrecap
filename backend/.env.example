DATABASE_URL=sqlite:///./rexcrop.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_BYTES=2147483648
FFMPEG_BINARY=ffmpeg
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OPENAI_API_KEY=your-openai-api-key
TRANSLATION_MODEL=gpt-4.1-mini
WORKER_POLL_INTERVAL=2.0
USER_STORAGE_QUOTA_BYTES=10737418240
# Object storage for job-output delivery (optional, default serves locally):
# STORAGE_BACKEND=s3
# S3_BUCKET=rexcrop-outputs
# S3_ENDPOINT_URL=https://minio.local:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# PRESIGNED_URL_EXPIRES_IN=3600
# Job notifications (optional): email alerts via SMTP, webhooks via per-user URLs.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=RexCrop <noreply@example.com>
# SMTP_USE_TLS=true
